{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-vs2022",
      "displayName": "Windows VS 2022 x64",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-vs2022",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "KBE_TEST_ASSETS": "$env{KBE_TEST_ASSETS}",
        "KBE_TEST_DATABASE_USERNAME": "$env{KBE_TEST_DATABASE_USERNAME}",
        "KBE_TEST_DATABASE_PASSWORD": "$env{KBE_TEST_DATABASE_PASSWORD}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-vs2022-debug",
      "configurePreset": "windows-vs2022",
      "configuration": "Debug",
      "targets": ["kbe_core_dependencies"]
    },
    {
      "name": "windows-vs2022-release",
      "configurePreset": "windows-vs2022",
      "configuration": "Release",
      "targets": ["kbe_core_dependencies"]
    },
    {
      "name": "windows-vs2022-libraries-debug",
      "configurePreset": "windows-vs2022",
      "configuration": "Debug",
      "targets": ["kbe_libraries"]
    },
    {
      "name": "windows-vs2022-libraries-release",
      "configurePreset": "windows-vs2022",
      "configuration": "Release",
      "targets": ["kbe_libraries"]
    },
    {
      "name": "windows-vs2022-kbcmd-debug",
      "configurePreset": "windows-vs2022",
      "configuration": "Debug",
      "targets": ["kbcmd"]
    },
    {
      "name": "windows-vs2022-kbcmd-release",
      "configurePreset": "windows-vs2022",
      "configuration": "Release",
      "targets": ["kbcmd"]
    },
    {
      "name": "windows-vs2022-servers-debug",
      "configurePreset": "windows-vs2022",
      "configuration": "Debug",
      "targets": ["kbe_servers"]
    },
    {
      "name": "windows-vs2022-servers-release",
      "configurePreset": "windows-vs2022",
      "configuration": "Release",
      "targets": ["kbe_servers"]
    },
    {
      "name": "windows-vs2022-runtime-debug",
      "configurePreset": "windows-vs2022",
      "configuration": "Debug",
      "targets": ["kbe_runtime"]
    },
    {
      "name": "windows-vs2022-runtime-release",
      "configurePreset": "windows-vs2022",
      "configuration": "Release",
      "targets": ["kbe_runtime"]
    }
  ],
  "testPresets": [
    {
      "name": "windows-vs2022-debug",
      "configurePreset": "windows-vs2022",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-vs2022-release",
      "configurePreset": "windows-vs2022",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
