<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    统一告诉 MSVC 源文件和执行字符集均使用 UTF-8，避免中文注释或字符串按本地代码页解析。
    Set both source and execution character sets to UTF-8 so MSVC does not reinterpret comments or literals using the local code page.
  -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    x64 工程统一使用 vcpkg manifest 和静态 triplet，避免各项目分别维护依赖路径。
    Use the vcpkg manifest and one static x64 triplet for every x64 project so dependency paths stay centralized.

    不在工程中写死开发机路径；VCPKG_ROOT 由构建环境提供，便于 CI 和其他开发机复用。
    Keep the vcpkg root outside the project file so CI and other developer machines can provide their own installation.
  -->
  <PropertyGroup Condition="'$(Platform)' == 'x64' Or '$(Platform)' == 'Win64'">
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
    <VcpkgManifestInstall>false</VcpkgManifestInstall>
    <VcpkgUseStatic>true</VcpkgUseStatic>
    <VcpkgTriplet>x64-windows-static</VcpkgTriplet>
    <VcpkgConfiguration Condition="'$(Configuration)' == 'Debug'">Debug</VcpkgConfiguration>
	<!--
	  VS 的 vcpkg targets 会在 VcpkgInstalledDir 后追加 triplet；这里只能提供安装根目录。
	  The VS vcpkg targets append the triplet to VcpkgInstalledDir, so this property must name only the install root.
	-->
	<VcpkgInstalledDir>$(MSBuildThisFileDirectory)vcpkg_installed</VcpkgInstalledDir>
    <KbeVcpkgInstalledDir>$(MSBuildThisFileDirectory)vcpkg_installed\$(VcpkgTriplet)</KbeVcpkgInstalledDir>
    <KbeVcpkgIncludeDir>$(KbeVcpkgInstalledDir)\include</KbeVcpkgIncludeDir>
    <KbeVcpkgLibraryDir Condition="'$(Configuration)' == 'Debug'">$(KbeVcpkgInstalledDir)\debug\lib</KbeVcpkgLibraryDir>
    <KbeVcpkgLibraryDir Condition="'$(Configuration)' != 'Debug'">$(KbeVcpkgInstalledDir)\lib</KbeVcpkgLibraryDir>
    <KbePythonVersion>3.12</KbePythonVersion>
    <KbePythonAbiVersion>312</KbePythonAbiVersion>
    <KbePythonTriplet Condition="'$(Platform)' == 'x64' Or '$(Platform)' == 'Win64'">x64-windows</KbePythonTriplet>
    <KbePythonTriplet Condition="'$(Platform)' == 'ARM64'">arm64-windows</KbePythonTriplet>
    <KbePythonInstallRoot>$(MSBuildThisFileDirectory)python-runtime\vcpkg_installed</KbePythonInstallRoot>
    <KbePythonInstalledDir>$(KbePythonInstallRoot)\$(KbePythonTriplet)</KbePythonInstalledDir>
    <KbePythonIncludeDir>$(KbePythonInstalledDir)\include\python$(KbePythonVersion)</KbePythonIncludeDir>
    <KbePythonLibraryDir>$(KbePythonInstalledDir)\lib</KbePythonLibraryDir>
    <KbePythonLibrary>python$(KbePythonAbiVersion).lib</KbePythonLibrary>
    <KbePythonRuntimeDir>$(KbePythonInstalledDir)\tools\python3</KbePythonRuntimeDir>
    <KbePythonBinaryDir>$(KbePythonInstalledDir)\bin</KbePythonBinaryDir>
  </PropertyGroup>

  <!--
    旧工程使用手写 vcxproj，不能依赖 CMake targets 自动传播 vcpkg 的目录。
    The legacy projects define their own vcxproj items, so vcpkg include and library paths must be propagated here.
  -->
  <ItemDefinitionGroup Condition="('$(Platform)' == 'x64' Or '$(Platform)' == 'Win64') And Exists('$(KbeVcpkgIncludeDir)')">
    <ClCompile>
      <AdditionalIncludeDirectories>$(KbeVcpkgIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(KbeVcpkgLibraryDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
</Project>
