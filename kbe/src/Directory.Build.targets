<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    解决方案与项目都允许并行构建，多个 cl.exe 可能同时写入同一项目 PDB；/FS 通过 MSVC 的串行写入协调器避免 C1041。
    Solutions and projects both permit parallel builds, so multiple cl.exe processes may write one project PDB; /FS uses MSVC's serialized writer to prevent C1041.

    该选项仅协调调试信息写入，不关闭并行编译，也不改变生成代码、ABI 或运行时行为。
    This option only coordinates debug-information writes; it keeps parallel compilation enabled and does not change generated code, ABI, or runtime behavior.
  -->
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalOptions>/FS %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    vendored 依赖保持上游源码形态，其平台兼容警告不应淹没 KBEngine 自有代码的警告门禁。
    Vendored dependencies retain their upstream source form, so their platform-compatibility warnings must not obscure the warning gate for KBEngine-owned code.

    仅关闭依赖项目及被其他项目直接编译的依赖源文件警告；KBEngine 源文件仍使用项目原有警告级别。
    Disable warnings only for dependency projects and dependency sources compiled by another project; KBEngine sources retain their configured warning level.
  -->
  <PropertyGroup>
    <_KbeIsDependencyProject>$([System.String]::Copy('$(MSBuildProjectDirectory)').ToLowerInvariant().Contains('\dependencies\'))</_KbeIsDependencyProject>
  </PropertyGroup>

  <ItemDefinitionGroup Condition="'$(_KbeIsDependencyProject)' == 'True'">
    <ClCompile>
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Update="..\dependencies\**\*.c;..\dependencies\**\*.cc;..\dependencies\**\*.cpp;..\dependencies\**\*.cxx">
      <WarningLevel>TurnOffAllWarnings</WarningLevel>
    </ClCompile>
  </ItemGroup>

  <!--
    vcpkg和vendored头文件作为外部系统边界编译，上游平台扩展警告不计入第一方零警告门禁。
    Compile vcpkg and vendored headers as external system boundaries so upstream platform-extension warnings do not enter the first-party zero-warning gate.

    源文件的单独隔离规则仍保留，这里补齐被KBEngine源文件include的第三方头文件。
    Per-source isolation remains in place; this additionally covers third-party headers included by KBEngine translation units.
  -->
  <ItemDefinitionGroup Condition="Exists('$(MSBuildThisFileDirectory)lib\dependencies')">
    <ClCompile>
      <ExternalWarningLevel>TurnOffAllWarnings</ExternalWarningLevel>
      <AdditionalOptions>/external:I"$(MSBuildThisFileDirectory)lib\dependencies" %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="Exists('$(KbeVcpkgIncludeDir)')">
    <ClCompile>
      <AdditionalOptions>/external:I"$(KbeVcpkgIncludeDir)" %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
  </ItemDefinitionGroup>

  <!--
    旧 vcxproj 在项目内部再次声明依赖路径，会把 Directory.Build.props 中的 vcpkg 路径挤到末尾。
    Legacy vcxproj files redeclare dependency paths inside each project and push the vcpkg paths from Directory.Build.props to the end.

    Directory.Build.targets 在项目定义之后生效，这里重新前置路径，确保同名头文件和库始终来自同一个 vcpkg triplet。
    Directory.Build.targets is evaluated after project definitions, so paths are prepended here to keep same-named headers and libraries on one vcpkg triplet.
  -->
  <ItemDefinitionGroup Condition="('$(Platform)' == 'x64' Or '$(Platform)' == 'Win64') And Exists('$(KbeVcpkgIncludeDir)')">
    <ClCompile Condition="'$(KbePreferBundledDependencies)' != 'true'">
      <AdditionalIncludeDirectories>$(KbeVcpkgIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Lib>
      <AdditionalLibraryDirectories>$(KbeVcpkgLibraryDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Lib>
    <Link>
      <AdditionalLibraryDirectories>$(KbeVcpkgLibraryDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

  <!--
    Python 头文件与导入库由独立 manifest 的官方动态 triplet 提供，Debug 和 Release 都使用同一套 Release ABI。
    Python headers and the import library come from an official dynamic triplet in the dedicated manifest, and both configurations share the Release ABI.
  -->
  <ItemDefinitionGroup Condition="'$(KbePythonTriplet)' != ''">
    <ClCompile>
      <PreprocessorDefinitions>PY_SSIZE_T_CLEAN;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(KbePythonIncludeDir);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(KbePythonLibraryDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>

</Project>
