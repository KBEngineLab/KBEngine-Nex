{
  "name": "stress",
  "fixture": "network-baseline",
  "duration_seconds": 1800,
  "bots": 2000,
  "connect_rate_per_second": 50,
  "warmup_seconds": 15,
  "performance_probes_enabled": true,
  "external_receive_messages": 1024,
  "external_receive_bytes": 1048576,
  "watcher_targets": [
    "BOTS_TYPE=@bots:root/bots/performance",
    "BASEAPP_TYPE=@baseapp:root",
    "BASEAPP_TYPE=@baseapp:root/stats",
    "BASEAPP_TYPE=@baseapp:root/network/channels",
    "BASEAPP_TYPE=@baseapp:root/network/poller",
    "BASEAPP_TYPE=@baseapp:root/network/kcp",
    "BASEAPP_TYPE=@baseapp:root/cprofiles/default/gameTick",
    "BASEAPP_TYPE=@baseapp:root/cprofiles/default/gameTick/latency",
    "BASEAPP_TYPE=@baseapp:root/cprofiles/default/scriptCall",
    "BASEAPP_TYPE=@baseapp:root/cprofiles/default/scriptCall/latency",
    "BASEAPP_TYPE=@baseapp:root/cprofiles/default/onTimer",
    "BASEAPP_TYPE=@baseapp:root/cprofiles/default/onTimer/latency",
    "CELLAPP_TYPE=@cellapp:root",
    "CELLAPP_TYPE=@cellapp:root/stats",
    "CELLAPP_TYPE=@cellapp:root/network/channels",
    "CELLAPP_TYPE=@cellapp:root/network/poller",
    "CELLAPP_TYPE=@cellapp:root/cprofiles/default/gameTick",
    "CELLAPP_TYPE=@cellapp:root/cprofiles/default/gameTick/latency",
    "CELLAPP_TYPE=@cellapp:root/cprofiles/default/scriptCall",
    "CELLAPP_TYPE=@cellapp:root/cprofiles/default/scriptCall/latency",
    "CELLAPP_TYPE=@cellapp:root/cprofiles/default/onTimer",
    "CELLAPP_TYPE=@cellapp:root/cprofiles/default/onTimer/latency",
    "CELLAPP_TYPE=@cellapp:root/cprofiles/default/clientUpdate",
    "CELLAPP_TYPE=@cellapp:root/cprofiles/default/clientUpdate/latency",
    "CELLAPP_TYPE=@cellapp:root/witness"
  ],
  "watcher_intervals": {
    "BOTS_TYPE:root/bots/performance": 5.0,
    "BASEAPP_TYPE:root": 2.0,
    "BASEAPP_TYPE:root/stats": 2.0,
    "BASEAPP_TYPE:root/network/channels": 2.0,
    "BASEAPP_TYPE:root/network/poller": 5.0,
    "BASEAPP_TYPE:root/network/kcp": 5.0,
    "CELLAPP_TYPE:root": 2.0,
    "CELLAPP_TYPE:root/stats": 2.0,
    "CELLAPP_TYPE:root/network/channels": 2.0,
    "CELLAPP_TYPE:root/network/poller": 5.0
  },
  "readiness": {
    "root/bots/performance/clientsTotal": "$bots",
    "root/bots/performance/clientsKcp": "$bots",
    "root/witness/active": "$bots"
  },
  "operation_mix": {
    "login": 0.1,
    "heartbeat": 0.5,
    "movement": 0.4
  },
  "thresholds": "../thresholds.json"
}
