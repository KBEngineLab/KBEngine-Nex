<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectName>python-runtime</ProjectName>
    <ProjectGuid>{86B36683-25C7-4C38-AC02-BD205A5FF56E}</ProjectGuid>
    <RootNamespace>python_runtime</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Utility</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Utility</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <!--
      该工具项目显式管理独立 Python manifest，不允许 VS 将主 manifest 自动安装到这个项目。
      This utility project manages the dedicated Python manifest explicitly and must not let VS install the main manifest for it.
    -->
    <VcpkgEnableManifest>false</VcpkgEnableManifest>
    <IntDir>..\_objs\python-runtime\$(Configuration)\</IntDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="vcpkg.json" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />

  <!--
    优先使用显式 VCPKG_ROOT，其次复用与 manifest baseline 一致的本机缓存，最后回退到 VS vcpkg。
    Prefer an explicit VCPKG_ROOT, then reuse the local root matching the manifest baseline, and finally fall back to VS vcpkg.
  -->
  <Target Name="KbeResolvePythonVcpkg">
    <PropertyGroup>
      <KbePythonVcpkgRoot Condition="'$(KbePythonVcpkgRoot)' == '' And '$(VCPKG_ROOT)' != ''">$(VCPKG_ROOT)</KbePythonVcpkgRoot>
      <KbePythonVcpkgRoot Condition="'$(KbePythonVcpkgRoot)' == '' And Exists('$(LOCALAPPDATA)\vcpkg\roots\2825cdd8\vcpkg.exe')">$(LOCALAPPDATA)\vcpkg\roots\2825cdd8</KbePythonVcpkgRoot>
      <KbePythonVcpkgRoot Condition="'$(KbePythonVcpkgRoot)' == '' And Exists('$(VcpkgRoot)\vcpkg.exe')">$(VcpkgRoot)</KbePythonVcpkgRoot>
      <KbePythonVcpkgRoot Condition="'$(KbePythonVcpkgRoot)' == '' And Exists('$(VCToolsInstallDir)..\..\..\vcpkg\vcpkg.exe')">$(VCToolsInstallDir)..\..\..\vcpkg</KbePythonVcpkgRoot>
      <KbePythonVcpkgExe>$(KbePythonVcpkgRoot)\vcpkg.exe</KbePythonVcpkgExe>
      <KbePythonDownloadsRoot>$(LOCALAPPDATA)\vcpkg\downloads</KbePythonDownloadsRoot>
    </PropertyGroup>
    <Error Condition="'$(KbePythonTriplet)' == ''"
           Text="Unsupported Python platform: $(Platform)." />
    <Error Condition="!Exists('$(KbePythonVcpkgExe)')"
           Text="Cannot install Python: vcpkg.exe was not found. Set VCPKG_ROOT or install the Visual Studio vcpkg component." />
  </Target>

  <!--
    只有 Python 运行时缺失时才调用 vcpkg，因此普通增量构建不会重复解析和安装依赖。
    Invoke vcpkg only when the Python runtime is absent so normal incremental builds do not resolve and install dependencies repeatedly.
  -->
  <Target Name="KbeInstallPythonRuntime"
          DependsOnTargets="KbeResolvePythonVcpkg"
          Condition="!Exists('$(KbePythonIncludeDir)\Python.h') Or !Exists('$(KbePythonLibraryDir)\$(KbePythonLibrary)') Or !Exists('$(KbePythonBinaryDir)\python$(KbePythonAbiVersion).dll')">
    <Message Importance="High"
             Text="Installing Python $(KbePythonVersion): platform=$(Platform), triplet=$(KbePythonTriplet), ABI=Release." />
    <Exec WorkingDirectory="$(MSBuildThisFileDirectory)"
          Command="&quot;$(KbePythonVcpkgExe)&quot; --vcpkg-root=&quot;$(KbePythonVcpkgRoot)&quot; install --triplet &quot;$(KbePythonTriplet)&quot; --x-install-root=&quot;$(KbePythonInstallRoot)&quot; --downloads-root=&quot;$(KbePythonDownloadsRoot)&quot;" />
  </Target>

  <Target Name="KbeValidatePythonRuntime" DependsOnTargets="KbeInstallPythonRuntime">
    <Error Condition="!Exists('$(KbePythonIncludeDir)\Python.h')"
           Text="Python headers are missing after installation: $(KbePythonIncludeDir)." />
    <Error Condition="!Exists('$(KbePythonLibraryDir)\$(KbePythonLibrary)')"
           Text="Python Release import library is missing: $(KbePythonLibraryDir)\$(KbePythonLibrary)." />
    <Error Condition="!Exists('$(KbePythonBinaryDir)\python$(KbePythonAbiVersion).dll')"
           Text="Python Release runtime is missing: $(KbePythonBinaryDir)\python$(KbePythonAbiVersion).dll." />
    <Error Condition="!Exists('$(KbePythonRuntimeDir)\Lib')"
           Text="Python standard library is missing: $(KbePythonRuntimeDir)\Lib." />
  </Target>

  <!--
    服务端 Debug 和 Release 统一部署 Release Python，并清理旧的 _d 产物，避免第三方扩展误加载 Debug ABI。
    Deploy Release Python for both server configurations and remove stale _d artifacts so third-party extensions cannot bind to the Debug ABI.
  -->
  <Target Name="KbeDeployPythonRuntime" DependsOnTargets="KbeValidatePythonRuntime">
    <PropertyGroup>
      <KbePythonServerDir>$(MSBuildThisFileDirectory)..\..\bin\server</KbePythonServerDir>
      <KbePythonScriptsDir>$(MSBuildThisFileDirectory)..\..\res\scripts\common</KbePythonScriptsDir>
    </PropertyGroup>
    <ItemGroup>
      <KbePythonRuntimeDll Include="$(KbePythonBinaryDir)\python3.dll;$(KbePythonBinaryDir)\python$(KbePythonAbiVersion).dll" />
      <KbePythonStdlib Include="$(KbePythonRuntimeDir)\Lib\**\*"
                       Exclude="$(KbePythonRuntimeDir)\Lib\**\__pycache__\**;$(KbePythonRuntimeDir)\Lib\**\*.pyc" />
      <KbePythonExtension Include="$(KbePythonRuntimeDir)\DLLs\*.pyd;$(KbePythonRuntimeDir)\DLLs\*.dll" />
      <KbeStalePythonDebugRuntime Include="$(KbePythonServerDir)\python*_d.dll;$(KbePythonScriptsDir)\DLLs\*_d.*" />
    </ItemGroup>
    <MakeDir Directories="$(KbePythonServerDir);$(KbePythonScriptsDir)\Lib;$(KbePythonScriptsDir)\DLLs" />
    <Delete Files="@(KbeStalePythonDebugRuntime)" />
    <Copy SourceFiles="@(KbePythonRuntimeDll)"
          DestinationFolder="$(KbePythonServerDir)"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(KbePythonStdlib)"
          DestinationFiles="@(KbePythonStdlib->'$(KbePythonScriptsDir)\Lib\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(KbePythonExtension)"
          DestinationFolder="$(KbePythonScriptsDir)\DLLs"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="KbePreparePythonRuntime"
          BeforeTargets="Build"
          DependsOnTargets="KbeDeployPythonRuntime" />
</Project>
