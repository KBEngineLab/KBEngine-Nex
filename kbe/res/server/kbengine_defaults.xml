<root>
	<!-- 服务端游戏逻辑 Tick 频率，单位 Hz。提高该值会同步增加脚本、移动、AOI 和网络调度频率，
		应根据实际 Entity 数量和 Tick 延迟压测调整。
		Server game-logic tick rate in Hz. Increasing it also raises script, movement, AOI and network
		scheduling frequency; tune it against real entity counts and tick latency.
	-->
	<gameUpdateHertz> 10 </gameUpdateHertz>

	<!-- Python asyncio事件循环在组件主线程中的调度间隔，单位为秒。
		0表示关闭引擎托管的asyncio；正值最低按0.01秒处理。
		仅在Python回调会返回协程或其他awaitable时启用。间隔越小，协程恢复延迟越低，
		但主线程调度开销越高；CPU密集型协程仍会阻塞组件Tick。
		Python asyncio event-loop scheduling interval on the component main thread, in seconds.
		0 disables engine-managed asyncio; positive values are clamped to at least 0.01 seconds.
		Enable it only when Python callbacks return coroutines or other awaitables. A shorter interval
		reduces coroutine resume latency but increases main-thread scheduling overhead; CPU-bound
		coroutines still block the component tick.
	-->
	<asyncioRepeatOffset> 0 </asyncioRepeatOffset>

	<!-- 启用网络、Witness、Space 等高频路径的性能探针。探针会增加计数、时钟读取和
		百分位统计窗口内存，生产环境默认关闭。
		Enable performance probes on hot paths such as Network, Witness and Space. Probes add counters,
		clock reads and percentile-window memory, so they are disabled in production by default.
	-->
	<performanceProbes>
		<enabled> false </enabled>
	</performanceProbes>

	<!-- GUIConsole、PyCluster 等远程管理协议共享的 Token，所有管理端必须配置相同值。
		空值会关闭认证，仅可用于隔离环境中的临时本机调试；项目必须覆盖默认示例值。
		Shared token for remote management clients such as GUIConsole and PyCluster. Every management
		client must use the same value. Empty disables authentication and is only suitable for temporary,
		isolated local debugging; projects must override this example value.
	-->
	<management>
		<adminToken> 8be0f32909da7702f7cf2424af6e9422b4881f70bd5991f973424fed24004e5e </adminToken>
	</management>
	
	<!-- 单客户端发送带宽限制，单位 bit/s。设置过低会造成发送积压，过高会放大慢客户端
		和瞬时流量对组件 Tick 的影响。
		Per-client send bandwidth limit in bits per second. Too low builds a send backlog; too high
		amplifies slow-client and burst-traffic impact on the component tick.
	-->
	<bitsPerSecondToClient> 20000 </bitsPerSecondToClient>				<!-- Type: Integer -->
	
	<!-- 非 0 时固定长度消息也强制携带包长，便于某些客户端协议实现；0 保留默认协议优化。
		可预先确定大小的固定消息通常省略包长，可变长度消息始终携带包长。
		When non-zero, fixed-size messages also carry a length field for clients that require it; zero
		keeps the normal protocol optimization. Variable-size messages always carry their length.
	-->
	<packetAlwaysContainLength> 0 </packetAlwaysContainLength>
	
	<!-- 将收发包内容输出到日志用于临时诊断。包格式化和独立日志会增加 CPU、磁盘 IO 及
		Logger 网络流量，不应在高负载环境长期启用。
		Dump sent and received packets for temporary diagnostics. Formatting and packet logs add CPU,
		disk I/O and Logger traffic and should not remain enabled under production load.
		
		debug_type:
			0: 不输出(Not output)
			1: 16进制输出(16 hexadecimal output)
			2: 字符流输出(Stringstream output)
			3: 10进制输出(10 hexadecimal output)
		use_logfile:
			是否独立一个log文件来记录包内容，文件名通常为
			(Whether the use of other log files ? such as:)
			appname_packetlogs.log
		disables/item:
			关闭某些包的输出
			(Some messages are not output)
	-->
	<trace_packet>
		<debug_type> 0 </debug_type>
		<use_logfile> false </use_logfile>
		<disables>
			<item>Encrypted::packets</item>
			<item>Baseappmgr::updateBaseapp</item>
			<item>Baseappmgr::onBaseappInitProgress</item>
			<item>Cellappmgr::updateCellapp</item>
			<item>Cellappmgr::onCellappInitProgress</item>
			<item>Loginapp::onBaseappInitProgress</item>
			<item>Cellapp::onUpdateDataFromClient</item>
			<item>Baseapp::onUpdateDataFromClient</item>
			<item>Baseapp::forwardMessageToClientFromCellapp</item>
			<item>Client::onUpdateVolatileData</item>
			<item>Client::onUpdateData</item>
			<item>Client::onUpdateBasePos</item>
			<item>Client::onUpdateData_xz</item>
			<item>Client::onUpdateData_xyz</item>
			<item>Client::onUpdateData_y</item>
			<item>Client::onUpdateData_r</item>
			<item>Client::onUpdateData_p</item>
			<item>Client::onUpdateData_ypr</item>
			<item>Client::onUpdateData_yp</item>
			<item>Client::onUpdateData_yr</item>
			<item>Client::onUpdateData_pr</item>
			<item>Client::onUpdateData_xz_y</item>
			<item>Client::onUpdateData_xz_p</item>
			<item>Client::onUpdateData_xz_r</item>
			<item>Client::onUpdateData_xz_yr</item>
			<item>Client::onUpdateData_xz_yp</item>
			<item>Client::onUpdateData_xz_pr</item>
			<item>Client::onUpdateData_xz_ypr</item>
			<item>Client::onUpdateData_xyz_y</item>
			<item>Client::onUpdateData_xyz_p</item>
			<item>Client::onUpdateData_xyz_r</item>
			<item>Client::onUpdateData_xyz_yr</item>
			<item>Client::onUpdateData_xyz_yp</item>
			<item>Client::onUpdateData_xyz_pr</item>
			<item>Client::onUpdateData_xyz_ypr</item>
		</disables>
	</trace_packet>
	
	<!-- 输出 Entity 创建、属性访问、初始化和 EntityDef 调试信息。该日志位于高频路径，
		正式环境不要长期启用。
		Log Entity creation, property access, initialization and EntityDef diagnostics. This is a
		hot-path diagnostic and should not remain enabled in production.
	-->
	<debugEntity> 0 </debugEntity>

	<publish>
		<!-- 发布状态, 可在脚本中获取该值。 KBEngine.publish()
			(apps released state, This value can be obtained in the script. KBEngine.publish())
			Type: Integer8
			0 : debug
			1 : release
			其他自定义(Other custom)
		-->
		<state> 0 </state>

		<!-- 客户端登录和协议检查使用的脚本版本标识；发布新客户端逻辑时由项目维护。
			Script version identifier used during client login and compatibility checks; update it when
			releasing new client-side game logic.
		 -->
		<script_version> 0.1.0 </script_version>
	</publish>
	
	<channelCommon> 
		<!-- 最后一次通信时间超过此时间则被认定为超时通道， 服务器将踢出该通道（秒）
			(If long (configurable value) no communication, channel will be kicked out of the server.)
		-->
		<timeout> 
			<internal> 60.0 </internal>
			<external> 60.0 </external>
		</timeout>
		
		<!-- Socket 读写缓冲区大小，单位字节；0 使用操作系统默认值。内部通道较大的缓冲区
			会减少突发阻塞，但会增加每个连接可能占用的内核内存。
			Socket send/receive buffer sizes in bytes; zero uses the operating-system default. Larger
			internal buffers absorb bursts but increase potential kernel memory per connection.
		-->
		<readBufferSize> 
			<internal>	16777216	</internal> 			<!-- 16M -->
			<external>	0			</external>				<!-- 系统默认(system default) -->
		</readBufferSize>
		<writeBufferSize> 
			<internal>	16777216	</internal>				<!-- 16M -->
			<external>	0			</external>				<!-- 系统默认(system default) -->
		</writeBufferSize>

		<!--
			Completion 后端的主循环公平性预算。数量限制是硬上限，时间限制是自适应算法的封顶值；
			0 表示关闭时间让步，但数量限制仍生效。未处理的 completion 会留到下一 Tick，不会丢失。
			Completion backend fairness budget. The count is a hard limit while the time value caps the
			adaptive budget; zero disables time yielding without disabling the count limit.
		-->
		<completionBudget>
			<maxCompletionsPerTick> 1024 </maxCompletionsPerTick>
			<maxProcessingTimeMS> 8 </maxProcessingTimeMS>
		</completionBudget>

		<!-- 内部 completion TCP 链路的生产端迟滞背压。达到高水位后，Witness 等可延后生产者
			保留去重后的业务待办，不再生成 Channel Bundle；降到低水位后恢复。0 表示关闭。
			Producer-side hysteresis for internal completion TCP links. At the high watermark, deferrable
			producers retain deduplicated business work instead of creating Channel bundles; zero disables it. -->
		<completionSendBackpressure>
			<internalHighBytes> 131072 </internalHighBytes>
			<internalLowBytes> 32768 </internalLowBytes>
		</completionSendBackpressure>
		
		<!-- 发送与接收窗口阈值。messages 按消息数、bytes 按字节数、tickSentBytes 按单 Tick
			发送量限制；0 表示不限制。critical 是告警或处置阈值，不会预分配对应大小的队列。
			Send/receive window thresholds. messages counts messages, bytes counts bytes, and tickSentBytes
			limits one tick's output; zero is unlimited. critical is an alert/action threshold, not preallocation.
		-->
		<windowOverflow>
			<send>
				<!-- 一个tick内发送的字节数溢出限制 
					(A tick, the value of the sent window overflow, 0 is unlimited)
				-->
				<tickSentBytes>
					<internal>	0			</internal>
					<external>	0			</external>
				</tickSentBytes>
				<messages>
					<critical>	1024		</critical>
					<internal>	65535		</internal>
					<external>	512		</external>
				</messages>
				<bytes>
					<internal>	0			</internal>
					<external>	1048576	</external>
				</bytes>
			</send>
			
			<receive>
				<messages>
					<!-- 外部消息在 KCP/AOI 突发时会集中于同一服务 Tick 到达；该阈值只控制告警与断开，
						不会预分配消息队列。保持有界但避免正常 MMO 扇出触发日志放大。
						External KCP/AOI messages may arrive in one server tick. These limits only govern
						warnings and condemnation and do not preallocate a per-channel message queue. -->
					<critical>	192			</critical>
					<internal>	65535		</internal>
					<external>	256			</external>
				</messages>
				<bytes>
					<internal>	0			</internal>
					<external>	65535		</external>
				</bytes>
			</receive>
		</windowOverflow>
		
		<!-- 加密通信，只对外部通道
			(Encrypted communication, channel-external only)
			
			可选择的加密方式(Optional encryption):
				0: 无加密(No Encryption)
				1: Blowfish
				2: RSA (res\key\kbengine_private.key)
		 -->
		<encrypt_type> 1 </encrypt_type>

		<!-- 可靠 UDP/KCP 队列和重传参数。队列值以数据段计数，设置过大会增加单连接内存和
			网络突发，设置过小会在丢包或 Tick 抖动时过早触发拥塞处置。
			Reliable UDP/KCP queue and retransmission settings. Queue sizes count segments; values that are
			too large increase per-channel memory and bursts, while small values react too early to loss or tick jitter. -->
		<reliableUDP>
			<readPacketsQueueSize>
				<internal> 1024 </internal>
				<external> 128 </external>
			</readPacketsQueueSize>
			<writePacketsQueueSize>
				<internal> 1024 </internal>
				<external> 128 </external>
			</writePacketsQueueSize>
			<!-- 外部单通道 KCP 自有发送 payload 的硬上限；0 表示仅使用 segment 上限。
				Hard limit for KCP-owned send payload per external channel; 0 keeps only the segment limit. -->
			<writeQueueMaxBytes>
				<external> 65536 </external>
			</writeQueueMaxBytes>
			<!-- 单通道一次 flush 输出的数据段预算（含首次发送和重传）；ACK/窗口探测不受限，0 表示无限制。
				Data segments emitted by one channel flush, including retransmits; ACKs/probes stay unlimited, 0 means unlimited. -->
			<flushSegmentsBudget>
				<internal> 0 </internal>
				<external> 4 </external>
			</flushSegmentsBudget>
			<!-- 外部 KCP 达到高水位时暂停对应 Cell Witness 的位置更新，降到低水位后恢复；high=0 表示关闭。
				Pause positional updates for the matching Cell Witness at the high watermark and resume below low; high=0 disables it. -->
			<volatileBackpressure>
				<!-- highSegments/highBytes 任一达到高水位时暂停对应 Witness 的位置/方向生产；
					两项都回落到 lowSegments/lowBytes 后恢复。高水位为 0 时关闭对应判断，
					低水位会被限制在高水位以内。
					Pause matching Witness position/direction production when either high watermark is reached;
					resume after both values fall below their low watermarks. A zero high value disables that test. -->
				<highSegments> 128 </highSegments>
				<lowSegments> 32 </lowSegments>
				<highBytes> 32768 </highBytes>
				<lowBytes> 8192 </lowBytes>
			</volatileBackpressure>
			<!-- KCP 更新周期和最小重传超时，单位毫秒；过低会增加 CPU、重传和网络放大。
				KCP update interval and minimum retransmission timeout in milliseconds; overly small values
				increase CPU usage, retransmissions and network amplification. -->
			<tickInterval> 10 </tickInterval>
			<minRTO> 50 </minRTO>
			<!-- 快速重传前允许跳过的 ACK 次数。
				Number of skipped ACKs before fast retransmission. -->
			<missAcksResend> 2 </missAcksResend>
			<!-- KCP MTU；0 使用实现默认值。公网部署需结合路径 MTU 验证，避免 IP 分片。
				KCP MTU; zero uses the implementation default. Validate against the path MTU to avoid IP fragmentation. -->
			<mtu> 0 </mtu>
			<!-- 是否启用 KCP 拥塞控制，以及是否启用低延迟模式。
				Enable KCP congestion control and low-latency mode respectively. -->
			<congestionControl> false </congestionControl>
			<nodelay> true </nodelay>
		</reliableUDP>

		<!-- HTTPS、WSS 或 SSL 通道使用的证书和私钥路径，按 KBE_RES_PATH 解析。
			Certificate and private-key paths for HTTPS, WSS or SSL channels, resolved through KBE_RES_PATH. -->
		<sslCertificate> key/server_cert.pem </sslCertificate>
		<sslPrivateKey> key/server_key.pem </sslPrivateKey>
	</channelCommon> 
	
	<!-- 关服倒计时(秒) 
		(Countdown to shutdown the server(seconds))
	-->
	<shutdown_time> 30.0 </shutdown_time>
	
	<!-- 关闭服务器的时候， 如果有未完成的任务， 服务器需要等待任务结束。
		每Tick（秒）检查一次
	(Shutdown the server, if you have not completed the task, the server needs to wait for the end of the mission.
		Time(seconds) for each waiting.)
	-->
	<shutdown_waittick> 1.0 </shutdown_waittick>
	
	<!-- callback默认超时时间(秒) 
		(The callback: default timeout(seconds))
	-->
	<callback_timeout> 300.0 </callback_timeout>

	<urlopen>
		<!-- 整个请求的最大耗时；0表示不限制，单位为秒。 -->
		<!-- Maximum duration for the complete request; zero means unlimited, in seconds. -->
		<timeout> 10 </timeout>
		<!-- 建立连接的最大耗时；0表示使用libcurl默认值，单位为秒。 -->
		<!-- Maximum connection time; zero uses the libcurl default, in seconds. -->
		<connectTimeout> 10 </connectTimeout>
		<!-- 持续低速的判定时长；与lowSpeedLimit任一为0时关闭低速中止。 -->
		<!-- Duration used to detect low throughput; zero here or in lowSpeedLimit disables low-speed aborts. -->
		<lowSpeedTime> 5 </lowSpeedTime>
		<!-- 低速阈值，单位为bytes/s。 -->
		<!-- Low-throughput threshold in bytes/s. -->
		<lowSpeedLimit> 30 </lowSpeedLimit>
	</urlopen>
	
	<thread_pool>
		<!-- 线程任务默认超时时间，单位秒。
			Default worker-task timeout in seconds.
		-->
		<timeout> 300.0 </timeout>
		<!-- 初始创建线程数、空闲时预创建线程数和最大线程数。提高这些值会增加栈内存，
			并可能放大数据库及 IO 后端的并发压力。
			Initial thread count, idle pre-created count and maximum thread count. Higher values consume
			more stack memory and may amplify concurrency against database and I/O backends. -->
		<init_create> 1 </init_create>
		<pre_create> 2 </pre_create>
		<max_create> 8 </max_create>
	</thread_pool>
	
	<!-- Email服务, 提供账号验证， 密码找回等等。
		(Email services, providing the account verification, password recovery, etc.)
	-->
	<email_service_config>server/email_service_defaults.xml</email_service_config>
		
	<interfaces>
		<!-- Python 入口模块，默认加载 kbemain。
			Python entry module; kbemain is loaded by default.
		-->
		<entryScriptFile> kbemain </entryScriptFile>
		
		<!-- Interfaces 服务地址和监听端口范围，多组游戏服务可共享一个 Interfaces。
			port_max 为 0 时从 port_min 开始选择可用端口。
			Interfaces service address and listening port range; multiple game clusters may share one
			Interfaces service. A zero port_max selects an available port starting at port_min.
		-->
		<host> localhost </host>
		<port_min> 30099 </port_min>
		<port_max> 30199 </port_max>
		
		<!-- 订单或外部请求上下文超时，单位秒。
			Order or external-request context timeout in seconds.
		-->
		<orders_timeout> 3600 	</orders_timeout>
		
		<!-- TCP listen backlog，最终有效值还受操作系统 SOMAXCONN 上限约束。
			TCP listen backlog; the operating-system SOMAXCONN limit still applies.
		 -->
		<SOMAXCONN> 511 </SOMAXCONN>
		
		<!-- Telnet 调试服务。端口占用时向后尝试；正式环境必须修改密码并限制网络访问。
			Telnet diagnostics service. Later ports are tried when occupied; change the password and
			restrict network access in production.
		-->
		<telnet_service>
			<port> 33000 </port>
			<password> pwd123456 </password>
			<!-- 连接后使用的默认命令层，通常为 python。
				Default command layer selected after connection, normally python.
			-->
			<default_layer> python </default_layer>
		</telnet_service>
	</interfaces>
	
	<dbmgr>
		<!-- Python 入口模块，默认加载 kbemain。
			Python entry module; kbemain is loaded by default.
		-->
		<entryScriptFile> kbemain </entryScriptFile>
			
		<!-- 输出数据库读写调试信息，会显著增加日志量，正式环境不要长期启用。
			Log database read/write diagnostics; this can substantially increase log volume and should
			not remain enabled in production.
		 -->
		<debug> false </debug>

		<!-- 是否允许多个服务组共享数据库。启用前必须明确账号、Entity ID、表结构和服务组隔离策略。
			Allow multiple server clusters to share the database. Define account, Entity ID, schema and
			cluster-isolation rules before enabling it.
		 -->
		<shareDB> false </shareDB>
		
		<!-- 是否允许客户端使用空 EntityDef 摘要。false 会保持协议一致性检查；不要用 true
			作为绕过 SDK 或 EntityDef 不一致的常规方案。
			Allow an empty client EntityDef digest. False preserves compatibility checks; do not use true
			as a routine workaround for stale SDK or EntityDef data.
		-->
		<allowEmptyDigest> false </allowEmptyDigest>					<!-- Type: Boolean -->
		
		<!-- 指定接口地址，可配置网卡名、MAC、IP
			（Interface address specified, configurable NIC/MAC/IP） 
		-->
		<internalInterface>  </internalInterface>

		<!-- executeRawDatabaseCommand命令黑名单，只拦截脚本直接提交的原始数据库命令。
			The executeRawDatabaseCommand blacklist applies only to raw commands submitted directly by scripts.
			多个词使用英文逗号分隔，匹配不区分大小写，并按数据库后端分别加载。
			Separate words with commas; matching is case-insensitive and loaded independently for each backend.
		-->
		<rawDatabaseCommandBlacklist>
			<!-- enable 只控制脚本 executeRawDatabaseCommand 的黑名单过滤，不替代最小权限数据库账号、
				审计和备份。各后端规则为英文逗号分隔且不区分大小写。
				enable only filters script-issued executeRawDatabaseCommand calls; it does not replace
				least-privilege database accounts, auditing or backups. Rules are comma-separated and case-insensitive. -->
			<enable> false </enable>
			<mysql>delete,drop,truncate,alter,rename,replace,grant,revoke,flush,lock,unlock,shutdown,load_file,load data,outfile,dumpfile,handler,optimize,repair,analyze,reset</mysql>
			<mongodb>drop,dropDatabase,delete,deleteOne,deleteMany,remove,findAndModify,findOneAndDelete,findOneAndReplace,renameCollection,eval,mapReduce,createUser,updateUser,dropUser,grantRolesToUser,revokeRolesFromUser,shutdown,shutdownServer,fsync,auth,logout,createIndexes,dropIndexes</mongodb>
			<postgresql>delete,drop,truncate,alter,rename,grant,revoke,copy,vacuum,reindex,cluster,analyze,discard,listen,notify,unlisten,lock,security label,comment,call,do,prepare,execute,deallocate</postgresql>
		</rawDatabaseCommandBlacklist>
		
		<!-- Interfaces进程的地址（参考interfaces中地址配置）
			(Address of Interfaces process)
		-->
		<InterfacesServiceAddr>
			<!-- false 时不向 Interfaces 转发相关账号和外部服务请求；true 时 DBMgr 认为这些请求
				由 Interfaces 或其第三方平台处理。
				When false, related account and external-service requests are not forwarded. When true,
				DBMgr delegates them to Interfaces or its third-party platform.
			-->
			<enable> true </enable>

			<!-- true 时自动把根级 interfaces.host/port 范围加入地址池，避免重复维护地址。
				Automatically add the root interfaces host/port range to the pool to avoid duplicate configuration.
			-->
			<addDefaultAddress> true </addDefaultAddress>

			<!-- 可增加多个 item/host/port 分担 Interfaces 请求压力。
				Additional item/host/port entries may distribute Interfaces request load.
			<item>
