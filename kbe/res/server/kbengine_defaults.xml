		<!-- Telnet服务, 如果端口被占用则向后尝试40001.. 
			(Telnet service, if the port is occupied backwards to try 40001)
		-->
		<telnet_service>
			<port> 40000 </port>
			<password> pwd123456 </password>
			<!-- 命令默认层 
				(layer of default the command)
			-->
			<default_layer> python </default_layer>
		</telnet_service>
		
		<!-- 服务端关闭过程的参数 
			(Parameter server shutdown process)
		-->
		<shutdown>
			<!-- 正常关服阶段每秒销毁的 Base Entity 数量。过大会放大销毁回调和持久化峰值，
				过小会延长关服时间。
				Base Entities destroyed per second during orderly shutdown. Large values amplify callback and
				persistence spikes; small values extend shutdown.
			-->
			<perSecsDestroyEntitySize> 100 </perSecsDestroyEntitySize>
		</shutdown>
		
		<respool>
			<!-- 可进入资源池的最大单资源大小，单位 KB。提高它会增加缓存内存上限。
				Maximum individual resource size admitted to the pool, in KB. Higher values increase cache memory exposure.
			-->
			<buffer_size> 1024 </buffer_size>
			
			<!-- 资源在池内超过该时间未访问后销毁，单位秒。
				Destroy pooled resources after this many seconds without access.
			-->
			<timeout> 600 </timeout>
			
			<!-- 资源池过期检查周期，单位秒。更短会提高回收及时性，也会增加扫描频率。
				Resource-pool expiry scan period in seconds. Shorter values reclaim sooner but scan more often.
			-->
			<checktick>60</checktick>
		</respool>
	</baseapp>
	
	<cellappmgr>
		<!-- listen监听队列最大值
		    (listen: Maximum listen queue)
		 -->
		<SOMAXCONN> 511 </SOMAXCONN>

		<!-- 指定接口地址，可配置网卡名、MAC、IP
			（Interface address specified, configurable NIC/MAC/IP） 
		-->
		<internalInterface>  </internalInterface>

		<!-- 自动分配 Space 时，各 CellApp 已确认加待确认的 Space 数量最大差值。
			候选范围内仍按实时 CPU load 和实体数选择；0 表示仅使用负载评分。
			Maximum confirmed-plus-pending Space-count skew for automatic placement.
			Live CPU load and entity count still choose within the candidate set; 0 disables the hard bound.
		-->
		<spaceAllocationMaxSkew> 2 </spaceAllocationMaxSkew>

		<!-- 新 Space 分配时 Witness pending/active 比例的评分权重，0 表示关闭。
			Placement score weight for the Witness pending/active ratio; 0 disables it.
		-->
		<witnessPendingPressureWeight> 1.0 </witnessPendingPressureWeight>
	</cellappmgr>
	
	<baseappmgr>
		<!-- listen监听队列最大值
		    (listen: Maximum listen queue)
		 -->
		<SOMAXCONN> 511 </SOMAXCONN>

		<!-- 指定接口地址，可配置网卡名、MAC、IP
			（Interface address specified, configurable NIC/MAC/IP） 
		-->
		<internalInterface>  </internalInterface>
	</baseappmgr>
	
	<loginapp>
		<!-- Python 入口模块，默认加载 kbemain。
			Python entry module; kbemain is loaded by default.
		-->
		<entryScriptFile> kbemain </entryScriptFile>
		
		<!-- 指定接口地址，可配置网卡名、MAC、IP
			（Interface address specified, configurable NIC/MAC/IP） 
		-->
		<internalInterface>  </internalInterface>
		<externalInterface>  </externalInterface>						<!-- Type: String -->
		
		<!-- 强制指定外部IP地址或者域名，在某些网络环境下，可能会使用端口映射的方式来访问局域网内部的KBE服务器，那么KBE在当前
			的机器上获得的外部地址是局域网地址，此时某些功能将会不正常。例如：账号激活邮件中给出的回调地址, 登录baseapp。
			注意：服务端并不会检查这个地址的可用性，因为无法检查。
			(Forced to specify an external IP-address or Domain-name, In some server environment, May use the port mapping to access KBE,
			So KBE on current machines on the external IP address may be a LAN IP address, Then some functions will not normal.
			For example: account activation email address given callback.
			Note: the availability of server does not check the address, because cannot check)
		-->
		<externalAddress>  </externalAddress>							<!-- Type: String -->
		
		<!-- LoginApp 客户端监听端口范围。TCP max=0 时从 min 开始选择可用端口；UDP 的 -1
			表示不提供 UDP 登录端口，登录阶段始终使用 TCP。
			LoginApp client port ranges. TCP max=0 selects an available port starting at min; UDP -1 disables
			the UDP login listener. Login always uses TCP.
		-->
		<externalTcpPorts_min> 20013 </externalTcpPorts_min>			<!-- Type: Integer -->
		<externalTcpPorts_max> 0 </externalTcpPorts_max>				<!-- Type: Integer -->
		<externalUdpPorts_min> -1 </externalUdpPorts_min>				<!-- Type: Integer -->
		<externalUdpPorts_max> -1 </externalUdpPorts_max>				<!-- Type: Integer -->
		
		<!-- 加密登录信息
			(The encrypted user login information)
			
			可选择的加密方式(Optional encryption):
				0: 无加密(No Encryption)
				1: Blowfish
				2: RSA (res\key\kbengine_private.key)
		 -->
		<encrypt_login> 2 </encrypt_login>
		
		<!-- listen监听队列最大值
		    (listen: Maximum listen queue)
		 -->
		<SOMAXCONN> 511 </SOMAXCONN>
		
		<!-- 账号的类型								(Account types)
			1: 普通账号								(Normal Account)
			2: email账号(需要激活)					(Email Account, Note: activation required.)
			3: 智能账号(自动识别Email， 普通号码等)	(Smart Account (Email or Normal, etc.))
		-->
		<account_type> 3 </account_type>
		
		<!-- 认证、激活和密码重置等 HTTP 回调服务地址。通常只有首个 LoginApp 开启，host 可能
			被 externalInterface 或 externalAddress 替换。
			HTTP callback service for authentication, activation and password reset. Normally only the first
			LoginApp enables it, and host may be replaced by externalInterface or externalAddress.
		-->
		<http_cbhost> localhost </http_cbhost>
		<http_cbport> 21103 </http_cbport>
		
		<!-- Telnet服务, 如果端口被占用则向后尝试31001.. 
			(Telnet service, if the port is occupied backwards to try 31001)
		-->
		<telnet_service>
			<port> 31000 </port>
			<password> pwd123456 </password>
			<!-- 命令默认层 
				(layer of default the command)
			-->
			<default_layer> python </default_layer>
		</telnet_service>
	</loginapp>		
	
	<machine>
		<!-- 工具和管理连接使用的 TCP 端口范围；max=0 时从 min 开始选择可用端口。
			TCP port range used by tools and management clients; max=0 selects an available port from min.
		-->
		<externalTcpPorts_min> 20099 </externalTcpPorts_min>			<!-- Type: Integer -->
		<externalTcpPorts_max> 0 </externalTcpPorts_max>				<!-- Type: Integer -->
		
		<!-- UDP 广播无法跨主机发现组件时，在 addresses/item 中显式填写需要探测的主机地址。
			当前 Machine 不再读取 externalUdpPorts_min/max，不要保留旧配置节点。
			When UDP broadcast cannot discover components across hosts, list explicit probe destinations in
			addresses/item. Machine no longer reads externalUdpPorts_min/max; remove those legacy nodes.
		-->
		<addresses>
			<!--<item> 127.0.0.1 </item>-->
			<!--<item> 192.168.10.18 </item>-->
		</addresses>
	</machine>
	
	<bots>
		<!-- Python 入口模块，默认加载 kbemain。
			Python entry module; kbemain is loaded by default.
		-->
		<entryScriptFile> kbemain </entryScriptFile>
			
		<!-- Bots 内部通信接口，可填写网卡名、MAC 或 IP。
			Bots internal interface; accepts a NIC name, MAC address or IP.
		-->
		<internalInterface>  </internalInterface>
		
		<!-- BaseApp 下发公网 externalAddress 时，true 让局域网 Bots 强制改用内网地址，避免压测
			流量绕行公网；公网端到端测试应保持 false。
			When BaseApp advertises a public externalAddress, true forces LAN Bots to use the internal address
			and avoids routing load traffic over the public network. Keep false for public end-to-end tests. -->
		<forceInternalLogin> false </forceInternalLogin>

		<!-- 登录成功后的 BaseApp 游戏连接协议，可选 kcp 或 tcp；LoginApp 登录阶段始终使用 TCP。
			纯协议压测必须固定该值，避免样本混杂。
			BaseApp gameplay transport after login: kcp or tcp. LoginApp authentication always uses TCP.
			Keep this fixed during protocol benchmarks so samples remain comparable. -->
		<transport> kcp </transport>

		<!-- KCP 建立失败时是否允许回退 TCP。纯 KCP 压测应设为 false，避免协议样本混杂。
			Whether failed KCP setup may fall back to TCP. Set false for pure KCP benchmarks. -->
		<allowTcpFallback> true </allowTcpFallback>
		
		<!-- LoginApp 地址和 TCP 端口范围；port_max=0 时从 port_min 开始选择可用端口。
			LoginApp address and TCP port range; port_max=0 selects an available port from port_min.
		-->
		<host> localhost </host>										<!-- Type: String -->
		<port_min> 20013 </port_min>									<!-- Type: Integer -->
		<port_max> 0 </port_max>									<!-- Type: Integer -->
		
		<!-- 客户端 Entity 初始化时是否触发属性 set_* 回调。关闭会改变 Bots 脚本初始化行为，
			应与真实客户端 SDK 的预期保持一致。
			Invoke property set_* callbacks during client Entity initialization. Disabling changes Bots script
			initialization behavior; keep it aligned with the real client SDK expectation. -->
		<isOnInitCallPropertysSetMethods> true </isOnInitCallPropertysSetMethods>
		
		<!-- 启动后自动创建 Bots：totalCount 为总数，tickTime 为批次间隔（秒），tickCount 为每批数量。
			批次过大会形成登录、数据库、AOI 和 Logger 瞬时峰值。
			Automatically create Bots after startup: totalCount is total Bots, tickTime is batch interval in
			seconds and tickCount is batch size. Large batches spike login, database, AOI and Logger load.
		-->
		<defaultAddBots> 
			<totalCount> 10  </totalCount>								<!-- Type: Integer -->
			<tickTime> 0.1  </tickTime>									<!-- Type: Float -->
			<tickCount> 5  </tickCount>									<!-- Type: Integer -->
		</defaultAddBots>
		
		<!-- Bots 账号生成和登录密码。压测应使用隔离账号并替换默认密码。
			Bots account generation and login password. Use isolated load-test accounts and replace the default password.
		-->
		<account_infos>
			<!-- 机器人账号名称的前缀 
				(The account name prefix)
			-->
			<account_name_prefix>		bot_	</account_name_prefix>
			
			<!-- 后缀增量为 0 时使用随机递增策略，否则按配置值递增。账号由前缀、Bots cid 和后缀组成；
				固定 cid 可让多次测试复用相同账号序列。
				A zero suffix increment uses randomized progression; otherwise the configured increment is used.
				Accounts combine prefix, Bots cid and suffix. Fix cid to reuse the same account sequence across runs.
			-->
			<account_name_suffix_inc>	0		</account_name_suffix_inc><!-- Type: Integer -->

			<account_password> pwd123456 </account_password>
		</account_infos>
		
		<!-- Telnet服务, 如果端口被占用则向后尝试51001.. 
			(Telnet service, if the port is occupied backwards to try 51001)
		-->
		<telnet_service>
			<port> 51000 </port>
			<password> pwd123456 </password>
			<!-- 命令默认层 
				(layer of default the command)
			-->
			<default_layer> python </default_layer>
		</telnet_service>
	</bots>
	
	<logger>
		<!-- Python 入口模块，默认加载 kbemain。
			Python entry module; kbemain is loaded by default.
		-->
		<entryScriptFile> kbemain </entryScriptFile>
			
		<!-- 指定接口地址，可配置网卡名、MAC、IP
