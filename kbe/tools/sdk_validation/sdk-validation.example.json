{
  "$schema": "./sdk-validation.schema.json",
  "schemaVersion": 1,
  "variables": {
    "AssetsPath": "D:/path/to/game_assets",
    "VsRoot": "E:/ProgramFiles/Microsoft Visual Studio/2022/Community",
    "GodotRoot": "D:/ProgramFiles/Godot/Godot_v4.7-stable_win64"
  },
  "workingDirectory": "${AssetsPath}",
  "resultsDirectory": "${AssetsPath}/logs/sdk-validation",
  "environment": {
    "KBE_ROOT": "${RepoRoot}",
    "KBE_RES_PATH": "${RepoRoot}/kbe/res;${AssetsPath};${AssetsPath}/scripts;${AssetsPath}/res",
    "KBE_BIN_PATH": "${RepoRoot}/kbe/bin/server"
  },
  "sdks": [
    {
      "name": "csharp",
      "generate": {
        "file": "${RepoRoot}/kbe/bin/server/kbcmd.exe",
        "arguments": ["--clientsdk=csharp", "--outpath=${AssetsPath}/generated/csharp"],
        "timeoutSeconds": 120
      },
      "build": {
        "file": "dotnet",
        "arguments": ["build", "${AssetsPath}/kbeclient/csharp-e2e/CsharpE2E.csproj", "-c", "Release"],
        "timeoutSeconds": 300
      },
      "run": {
        "file": "dotnet",
        "arguments": ["run", "--project", "${AssetsPath}/kbeclient/csharp-e2e/CsharpE2E.csproj", "-c", "Release", "--no-build"],
        "timeoutSeconds": 120,
        "requiredPatterns": ["E2E_PASS .*component-initial=true.*entity-rpc=dialog"],
        "forbiddenPatterns": ["E2E_FAIL", "E2E_EXCEPTION", "SDK_ERROR"]
      }
    },
    {
      "name": "cxx",
      "generate": {
        "file": "${RepoRoot}/kbe/bin/server/kbcmd.exe",
        "arguments": ["--clientsdk=cxx", "--outpath=${AssetsPath}/generated/cxx"],
        "timeoutSeconds": 120
      },
      "build": {
        "file": "${VsRoot}/MSBuild/Current/Bin/MSBuild.exe",
        "arguments": ["${AssetsPath}/kbeclient/cxx-e2e/CxxE2E.vcxproj", "/m:1", "/nr:false", "/t:Rebuild", "/p:Configuration=Release", "/p:Platform=x64", "/p:PlatformToolset=v143", "/v:minimal"],
        "timeoutSeconds": 600
      },
      "run": {
        "file": "${AssetsPath}/kbeclient/cxx-e2e/bin/x64/Release/CxxE2E.exe",
        "timeoutSeconds": 120,
        "requiredPatterns": ["E2E_PASS .*component-initial=true.*entity-rpc=dialog"],
        "forbiddenPatterns": ["E2E_FAIL", "E2E_EXCEPTION", "SDK_ERROR"]
      }
    },
    {
      "name": "typescript",
      "generate": {
        "file": "${RepoRoot}/kbe/bin/server/kbcmd.exe",
        "arguments": ["--clientsdk=typescript", "--outpath=${AssetsPath}/generated/typescript"],
        "timeoutSeconds": 120
      },
      "build": {
        "file": "npm.cmd",
        "arguments": ["run", "build"],
        "workingDirectory": "${AssetsPath}/kbeclient/typescript-e2e",
        "timeoutSeconds": 300
      },
      "run": {
        "file": "npm.cmd",
        "arguments": ["run", "test:e2e"],
        "workingDirectory": "${AssetsPath}/kbeclient/typescript-e2e",
        "timeoutSeconds": 120,
        "requiredPatterns": ["E2E_PASS .*relogin=true.*component-rebuilt=true.*entity-rpc=dialog"],
        "forbiddenPatterns": ["E2E_FAIL", "E2E_EXCEPTION", "SDK_ERROR"]
      }
    },
    {
      "name": "gdscript",
      "generate": {
        "file": "${RepoRoot}/kbe/bin/server/kbcmd.exe",
        "arguments": ["--clientsdk=gdscript", "--outpath=${AssetsPath}/generated/gdscript"],
        "timeoutSeconds": 120
      },
      "build": {
        "file": "${GodotRoot}/Godot_v4.7-stable_win64_console.exe",
        "arguments": ["--headless", "--path", "${AssetsPath}/kbeclient/gdscript-e2e", "--editor", "--quit-after", "1"],
        "timeoutSeconds": 300,
        "forbiddenPatterns": ["SCRIPT ERROR", "Parse Error"]
      },
      "run": {
        "file": "${GodotRoot}/Godot_v4.7-stable_win64_console.exe",
        "arguments": ["--headless", "--path", "${AssetsPath}/kbeclient/gdscript-e2e", "--quit-after", "120"],
        "timeoutSeconds": 130,
        "requiredPatterns": ["E2E_PASS .*transport=kcp.*component-initial=true.*entity-rpc=dialog"],
        "forbiddenPatterns": ["E2E_FAIL", "E2E_EXCEPTION", "SDK_ERROR", "SCRIPT ERROR", "Parse Error"]
      }
    }
  ]
}
